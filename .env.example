# Taqdiri Cloud Environment Contract (Copy to .env for staging/production builds)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Set to true in CI/staging/production builds to fail fast if target env vars are missing
VITE_REQUIRE_EXPLICIT_SUPABASE=false

# AI Execution Routing:
# - auto: uses TanStack Server Function first, falls back cleanly to Supabase Edge Function on static Pages hosting
# - server: strictly calls TanStack Start Server Function
# - edge: strictly calls Supabase Edge Function (ai-estimation)
VITE_AI_EXECUTION_MODE=auto

# Server-Only Secrets (NEVER prefix with VITE_, set in Cloudflare/Nitro runtime or Supabase Edge Secrets):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
